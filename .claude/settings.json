{
  "permissions": {
    "allow": [
      "Skill(prd-writing)",
      "Skill(functional-design)",
      "Skill(architecture-design)",
      "Skill(repository-structure)",
      "Skill(development-guidelines)",
      "Skill(glossary-creation)",
      "Skill(design-tokens)",
      "Skill(steering)",
      "Skill(orchestration)"
    ],
    "deny": [],
    "ask": []
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/scripts/check-log-companion.mjs\"",
            "timeout": 20,
            "statusMessage": "log.md追記漏れを検査中..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/scripts/guard-gated-commit.mjs\"",
            "timeout": 10,
            "statusMessage": "commit がゲート経由か検査中..."
          }
        ]
      }
    ]
  }
}
