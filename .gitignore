# Claude Code local settings
.claude/settings.local.json

# Claude Code のエージェント作業ツリー（リポジトリの完全な複製・依存を入れると1つ数百MB）
# 追跡すると GB 単位の untracked が出続け、Docker のビルドコンテキストにも紛れ込む。
# 併せて .dockerignore にも `.claude` を入れること（.dockerignore の
# パターンはルート直下にしか一致しないため `node_modules` だけでは落ちない）。
.claude/worktrees/

# ↓ /init-stack 実行で言語固有のエントリがここに追記されます
target/
# 別の CARGO_TARGET_DIR（target-p4 など。常駐しているペットの exe を上書きしないためのビルド先）
/target-*/
__pycache__/

# ウェイクワードの道具（F20 は保留。K 2026-10-26「ウェイクワード関連のフォルダ、ファイルは gitignore にして」）。
# 中身は commit 25f7b23・f2bac67 の履歴に残る。再開する時はここを外して git add し直す
/scripts/wake/

# Tauri が生成するスキーマ
crates/pet-app/gen/
